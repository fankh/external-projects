# 세션 토큰 서명 키 — 운영 필수. 생성: openssl rand -hex 32
# 미설정 시 백엔드 기동 거부(EDIM_DEV_MODE=1 이면 개발용 기본 키 사용)
EDIM_SECRET=

# Anthropic API key for AI drawing generation (leave empty to use the built-in stub)
ANTHROPIC_API_KEY=

# Default Claude model for prompt -> drawing generation (overridable per request
# from the UI model picker). Allowed: claude-opus-4-8, claude-opus-4-7,
# claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_MODEL_ID=claude-opus-4-8

# Full path to ODA File Converter executable for DWG -> DXF conversion
# e.g. C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
ODA_FILE_CONVERTER_PATH=
