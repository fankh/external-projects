# 전사 IT·보안 거버넌스 포털 — 실배포 환경변수 참조
# 이 파일을 .env 로 복사해 값을 채운다 (또는 docker -e / compose environment 로 주입).
# 게이트(smoke/e2e/health)는 별도 설정 없이 개발용 기본값으로 동작하므로, 아래는 실배포 기준이다.

# [필수] 세션 쿠키 HMAC 서명 키.
#   미설정 시 소스에 있는 개발용 기본 키로 동작한다 — 프로덕션에서는 세션 위조가 가능하므로 반드시 교체.
#   기동 훅(instrumentation.ts)이 프로덕션에서 미설정을 감지하면 경고를 출력한다.
#   예: openssl rand -base64 32
SESSION_SECRET=

# [선택] 고객사 프로필 — 브랜딩·연동 채널 구성을 통째로 전환한다 (빌드 불변, 한 이미지 다 고객사).
#   미설정=default · manufacturer(제조업 예시) · public(공공기관 예시)
#   새 고객사는 profiles/ 에 구성 추가 + portal.config.ts 선택지 등록 (docs/구축_요약.md).
PORTAL_PROFILE=

# [선택] 파일 기반 영속화 — 설정 시 스토어를 이 경로에 저장해 재시작 후에도 유지된다.
#   미설정이면 인메모리(기동 시 시드 초기화). Docker 는 /data 볼륨을 쓴다.
PORTAL_DATA_FILE=

# [선택] HTTPS 종단 배포 시 1 — 세션 쿠키에 Secure 속성을 붙인다.
PORTAL_COOKIE_SECURE=

# [선택] 일일 알림 배치 주기(ms). 설정 시 스케줄러가 뜬다 (미서약·점검 경과·SR 지연 등 안내메일).
#   미설정이면 스케줄러 없이 연동·인프라 화면의 수동 실행만. Docker 기본 86400000(24h).
PORTAL_NOTIFY_INTERVAL_MS=

# [선택] 어댑터 호출 상한 시간(ms). 실 고객사 시스템이 응답 없이 매달릴 때 포털 요청·배치가
#   무한 대기하지 않도록 초과 시 실패 처리한다. 미설정 기본 10000(10초). 목 어댑터는 영향 없음.
PORTAL_ADAPTER_TIMEOUT_MS=

# [선택] 게이트용 파이썬 인터프리터 지정 — health/e2e 가 playwright 있는 파이썬을 못 찾을 때.
#   scripts/pyrun.mjs 가 PORTAL_PYTHON → py → python3 → python 순으로 해석한다.
PORTAL_PYTHON=
